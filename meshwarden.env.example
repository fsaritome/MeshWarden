# MeshWarden configuration - copy to meshwarden.env, chmod 600, fill in.
# Never commit the real file.

# --- MeshCore companion (WiFi firmware, TCP) - required
NODE_HOST=192.168.1.50
NODE_PORT=5000

# --- who may talk to the bot (comma separated public key prefixes, 12 hex chars)
ALLOWED_KEYS=
# who gets alerts and the morning summary (usually yourself)
ALERT_KEYS=

# --- Prometheus with a solar exporter (battery_voltage, battery_current, mppt_pv_power, ...)
PROM_URL=http://127.0.0.1:9090
PROM_JOB=solar

# --- optional: Home Assistant (Profile > Security > Long-lived access tokens)
HA_URL=
HA_TOKEN=
# optional explicit sensor list, otherwise all temperature/humidity sensors
HA_SENSORS=

# --- optional: TrueNAS (user menu > API Keys), self-signed TLS is accepted
NAS_URL=
NAS_KEY=

# --- optional: your own repeater for the "mesh" command (public key prefix + guest/admin pw)
REPEATER_KEY=
REPEATER_PW=

# --- optional
GATEWAY=192.168.1.1
SUMMARY_AT=07:00
BOT_TZ=Europe/Berlin
COOLDOWN_S=3
RATE_PER_MIN=10
LOG_LEVEL=INFO
